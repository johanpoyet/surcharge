{
  "expo": {
    "name": "Surcharge",
    "slug": "surcharge",
    "scheme": "surcharge",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.johanpoyet.surcharge",
      "appleTeamId": "R7GAYTSBWH",
      "infoPlist": {
        "NSCameraUsageDescription": "Pour photographier tes machines et exercices.",
        "NSPhotoLibraryUsageDescription": "Pour photographier tes machines et exercices."
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "fr.johanpoyet.surcharge",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "./plugins/withAndroidReleaseSigning",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#0A0A0A"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour photographier tes machines et exercices.",
          "cameraPermission": "Pour photographier tes machines et exercices.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.785547112745-1a6oh9j6d5ri3980hkulptrkvlrlqghd"
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://de.sentry.io/",
          "organization": "johan-ea",
          "project": "surcharge"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "fr.johanpoyet.surcharge.widgets",
          "groupIdentifier": "group.fr.johanpoyet.surcharge"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a440ecb1-b057-441e-a1ed-73834ee9ea24"
      }
    },
    "owner": "johanpoyet",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a440ecb1-b057-441e-a1ed-73834ee9ea24",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
