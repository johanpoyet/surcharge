{
  "expo": {
    "name": "Surcharge",
    "slug": "surcharge",
    "scheme": "surcharge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.johanpoyet.surcharge",
      "appleTeamId": "R7GAYTSBWH",
      "infoPlist": {
        "NSCameraUsageDescription": "Pour photographier tes machines et exercices.",
        "NSPhotoLibraryUsageDescription": "Pour photographier tes machines et exercices."
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.johanpoyet.surcharge",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#0A0A0A"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour photographier tes machines et exercices.",
          "cameraPermission": "Pour photographier tes machines et exercices.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a440ecb1-b057-441e-a1ed-73834ee9ea24"
      }
    },
    "owner": "johanpoyet"
  }
}
